{
  "name": "pi-auto-compact",
  "version": "1.2.2",
  "description": "Minimal Pi extension that automatically compacts context at a configurable usage threshold.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "compaction"
  ],
  "license": "MIT",
  "author": "Chasen Liao",
  "repository": {
    "type": "git",
    "url": "https://github.com/Chasen-Liao/pi-auto-compact.git"
  },
  "homepage": "https://github.com/Chasen-Liao/pi-auto-compact#readme",
  "bugs": {
    "url": "https://github.com/Chasen-Liao/pi-auto-compact/issues"
  },
  "files": [
    "extensions",
    "README.md",
    "LICENSE",
    "tsconfig.json"
  ],
  "pi": {
    "extensions": [
      "./extensions/*.ts"
    ]
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.84.3"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node test/smoke.ts"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.3",
    "@types/node": "^26.4.0",
    "typescript": "^5.0.0"
  }
}
